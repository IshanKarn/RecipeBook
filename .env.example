# Copy to .env and adjust. Never commit .env.

# --- Application -------------------------------------------------------------
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO
# Public origin of the backend, used to build canonical and media URLs.
PUBLIC_BASE_URL=http://localhost:8000
# Comma-separated list (or JSON array). Wildcard "*" is rejected in production.
CORS_ORIGINS=http://localhost:5173

# --- Database ----------------------------------------------------------------
# Async driver URL used by the app. docker-compose.dev.yml publishes Postgres on 5434.
DATABASE_URL=postgresql+asyncpg://recipebook:recipebook@localhost:5434/recipebook
# Separate database used by the test suite (created by docker/postgres/init).
TEST_DATABASE_URL=postgresql+asyncpg://recipebook:recipebook@localhost:5434/recipebook_test
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_CONNECT_TIMEOUT_SECONDS=5

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- AI ----------------------------------------------------------------------
# Checked lazily by the AI adapter (module 04); not required to boot the API.
GEMINI_API_KEY=

# --- Storage -----------------------------------------------------------------
# local | s3
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Ingredient images -------------------------------------------------------
# wikimedia | unsplash | pexels
IMAGE_PROVIDER=wikimedia
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# --- Upload limits (enforced server-side in module 02) -------------------------
MAX_AUDIO_MB=50
MAX_VIDEO_MB=500
MAX_IMAGE_MB=10
MAX_COOKING_IMAGES=20
